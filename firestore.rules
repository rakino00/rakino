rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/notations/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.priority in ['nv1', 'nv2', 'nv3']
        && request.resource.data.type in ['task', 'reminder'];
    }

    // Perfil e preferências: somente o próprio usuário pode ler/editar seu documento.
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Chat comunitário: apenas usuários autenticados participam.
    // A interface carrega no máximo as 255 mensagens mais recentes.
    match /chatMessages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Salas do Rakino Race: lobby e sinalização simples para o multiplayer.
    match /raceRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && resource.data.host == request.auth.uid;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }

      match /shots/{shotId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.shooter == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // RakinoFood: cada usuário possui um único estado privado dentro do próprio UID.
    match /users/{uid}/rakinoFood/{docId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Web Projects são públicos para leitura. Somente o administrador pode alterar.
    match /webProjects/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'rakifernn@gmail.com';
    }

    // Recordes públicos dos jogos. O maior score vence; a interface só envia
    // scores do próprio usuário autenticado.
    match /gameRecords/{gameId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score > resource.data.score
        && request.resource.data.score <= 100000000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow delete: if false;
    }

    // Recorde do Saltador: leitura pública; atualização por usuário autenticado.
    // Visitantes não autenticados mantêm o recorde localmente neste navegador.
    match /saltador/{recordId} {
      allow read: if recordId == 'record';
      allow create, update: if recordId == 'record' && request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow delete: if false;
    }

    // Minha Vida: timeline pública, escrita somente pelo administrador.
    match /lifePosts/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'rakifernn@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
